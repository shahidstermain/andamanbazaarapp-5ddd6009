# Nginx reverse proxy configuration for self-hosted Supabase
# Install on the Hostinger VPS and configure with certbot for SSL
#
# Installation:
#   sudo apt-get install nginx certbot python3-certbot-nginx
#   sudo cp nginx.conf.template /etc/nginx/sites-available/andamanbazaar-api
#   sudo ln -s /etc/nginx/sites-available/andamanbazaar-api /etc/nginx/sites-enabled/
#   sudo certbot certonly --standalone -d api.andamanbazaar.in
#   sudo nginx -t
#   sudo systemctl restart nginx

upstream supabase_kong {
    server localhost:8000;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name api.andamanbazaar.in;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.andamanbazaar.in;

    # SSL Certificate (managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/api.andamanbazaar.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.andamanbazaar.in/privkey.pem;

    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Logging
    access_log /var/log/nginx/andaman-api-access.log combined;
    error_log /var/log/nginx/andaman-api-error.log warn;

    # Rate limiting (prevent abuse)
    limit_req_zone $binary_remote_addr zone=api:10m rate=100r/s;
    limit_req zone=api burst=200 nodelay;

    # Proxy settings
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $server_name;

    # WebSocket support (for Realtime)
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400;

    # CORS headers (allow frontend)
    add_header 'Access-Control-Allow-Origin' 'https://andamanbazaar.in' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Client-Info, apikey' always;

    # Handle OPTIONS requests
    if ($request_method = 'OPTIONS') {
        return 204;
    }

    # Proxy all requests to Kong
    location / {
        proxy_pass http://supabase_kong;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
