# Self-hosted Supabase Stack Configuration
# Copy this to .env.docker and fill in the values before deploying

# ═══════════════════════════════════════════════════════════════════════════════
# PostgreSQL
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_PASSWORD=generate_a_strong_random_password

# ═══════════════════════════════════════════════════════════════════════════════
# JWT & Security
# ═══════════════════════════════════════════════════════════════════════════════
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_strong_random_key

# ═══════════════════════════════════════════════════════════════════════════════
# Frontend URLs
# ═══════════════════════════════════════════════════════════════════════════════
SITE_URL=https://andamanbazaar.in
API_URL=https://api.andamanbazaar.in

# ═══════════════════════════════════════════════════════════════════════════════
# Google OAuth Configuration
# ═══════════════════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your_rotated_google_client_id.apps.googleusercontent.com
GOOGLE_SECRET=your_rotated_google_secret

# ═══════════════════════════════════════════════════════════════════════════════
# Email Configuration (Resend)
# ═══════════════════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM_EMAIL=noreply@andamanbazaar.in
SMTP_ADMIN_EMAIL=admin@andamanbazaar.in

# ═══════════════════════════════════════════════════════════════════════════════
# MinIO S3 Storage (Local S3-compatible)
# ═══════════════════════════════════════════════════════════════════════════════
# For production, consider using AWS S3 or similar
MINIO_ACCESS_KEY=generate_a_strong_access_key
MINIO_SECRET_KEY=generate_a_strong_secret_key

# ═══════════════════════════════════════════════════════════════════════════════
# Edge Function Secrets
# ═══════════════════════════════════════════════════════════════════════════════

# Resend
RESEND_API_KEY=re_your_api_key
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret
SEND_EMAIL_HOOK_SECRET=generate_random_secret_for_auth_hook

# Cashfree Payments
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
CASHFREE_ENV=PROD  # or SANDBOX for testing

# AI Providers
MINIMAX_API_KEY=your_minimax_api_key
GEMINI_API_KEY=your_gemini_api_key
LOVABLE_API_KEY=optional_lovable_fallback_key

# Affiliate & Content Agents
AFFILIATE_CONVERSION_SECRET=generate_random_secret
NEWS_AGENT_SECRET=generate_random_secret
AGENT_AUTHOR_ID=uuid_of_system_author_user
AFFILIATE_SUMMARY_FROM=noreply@andamanbazaar.in
AFFILIATE_SUMMARY_TO=admin@andamanbazaar.in

# ═══════════════════════════════════════════════════════════════════════════════
# Instructions for generating secrets:
# ═══════════════════════════════════════════════════════════════════════════════
#
# Generate strong random values:
#   openssl rand -hex 32
#
# For JWT_SECRET and MINIO keys:
#   openssl rand -hex 32
#
# Google OAuth:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a new OAuth 2.0 Client ID (Web Application)
#   3. Add authorized JavaScript origins: https://api.andamanbazaar.in
#   4. Add authorized redirect URIs: https://api.andamanbazaar.in/auth/v1/callback
#   5. Copy the Client ID and Client Secret
#
# Resend:
#   1. Go to https://resend.com/api-keys
#   2. Create a new API key
#   3. Add verified domain: andamanbazaar.in
#   4. Use the API key as RESEND_API_KEY
#
# MinIO (local S3):
#   Already set to minioadmin/minioadmin by default
#   For production, use AWS S3 and update STORAGE_* vars in docker-compose.yml
#
# ═══════════════════════════════════════════════════════════════════════════════
